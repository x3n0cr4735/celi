# Parser Challenge Environment Variables
GOOGLE_API_KEY=your-google-api-key-here

# Required: Anthropic API key for Claude access
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Default model for parser challenge (Claude Sonnet 4)
PRIMARY_LLM=claude-sonnet-4-20250514

# Optional: Maximum tokens per LLM call
MAX_TOKENS=4096

# Optional: Token budget for entire run (default: 10M)
TOKEN_BUDGET=10000000