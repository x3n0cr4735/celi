ay of individual loan billing statements\\n    - extra: Additional metadata or future extensions\\n    \\"\\"\\"\\n    # Split into lines preserving original line structure\\n    lines = raw_text.split(\'\\\\n\')\\n    \\n    # Extract phone number from document (RegionalBank specific)\\n    phone_number = extract_phone_number(raw_text)\\n    \\n    # Initialize document structure following JSON schema\\n    document = {\\n        \\"metadata\\": {\\n            \\"bank_name\\": \\"\\",  # Not typically present in LN6280P documents\\n            \\"document_type\\": \\"LN6280P\\",\\n            \\"document_date\\": extract_document_date(lines) or \\"\\",  # Use first statement date\\n            \\"form_type\\": \\"Loan Billing Statement\\",\\n            \\"processing_date\\": None,  # Not available in source document\\n            \\"processing_time\\": None,  # Not available in source document\\n            \\"extra\\": {\\n                # Jack Henry format indicators\\n                \\"format_type\\": \\"JH_ABSOLUTE_RELATIVE\\",  # Jack Henry absolute/relative line numbering\\n                \\"line_prefix_format\\": True  # Indicates use of line number prefixes\\n            }\\n        },\\n        \\"bank\\": {\\n            # Bank details are not typically present in LN6280P documents\\n            \\"name\\": \\"\\",\\n            \\"address\\": {\\"street\\": None, \\"city\\": None, \\"state\\": None, \\"zip\\": None},  # Explicit null values\\n            \\"phone\\": phone_number,  # Extract phone number for RegionalBank\\n            \\"routing_number\\": None,\\n            \\"extra\\": {}\\n        },\\n        \\"notices\\": [],  # Will be populated with parsed loan statements\\n        \\"extra\\": {}\\n    }\\n\\n    # Find all section boundaries in the document\\n    boundaries = find_section_boundaries(lines)\\n    \\n    # Process each section as a separate loan statement\\n    for i in range(len(boundaries)):\\n        # Calculate section 