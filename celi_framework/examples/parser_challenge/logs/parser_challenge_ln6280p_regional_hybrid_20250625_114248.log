ls[\'past_due_amount\'] = extract_summary_field(section_text, [r\'Past Due Amount\\\\s*\\\\*\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'])\\n    details[\'credit_limit\'] = extract_summary_field(section_text, [r\'Credit Limit\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'])\\n    details[\'available_credit\'] = extract_summary_field(section_text, [r\'Available Credit\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'])\\n    \\n    # Payment breakdown fields from right column of summary table (support both formats)\\n    details[\'regular_payment_amount\'] = extract_summary_field(section_text, [\\n        r\'Regular Payment Amount\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\',  # JH format\\n        r\'Monthly Payment\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'          # RegionalBank format\\n    ])\\n    details[\'principal_due\'] = extract_summary_field(section_text, [r\'Principal\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'])\\n    details[\'interest_due\'] = extract_summary_field(section_text, [r\'Interest\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'])\\n    details[\'total_late_fees\'] = extract_summary_field(section_text, [r\'Total Late Fees\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'])\\n\\n    # Extract multi-line text blocks and clean them\\n    \\n    # Past due footnote - handle line breaks and line prefixes\\n    footnote_match = re.search(r\'(\\\\*Past due amount includes total late.*?fees owed\\\\.)\', section_text, re.DOTALL)\\n    if footnote_match:\\n        footnote_text = footnote_match.group(1)\\n        # Remove line prefixes and normalize whitespace\\n        cleaned_footnote = re.sub(r\'\\\\s*\\\\n\\\\s*\\\\d*\\\\s*\', \' \', footnote_text).strip()\\n        details[\'past_due_footnote\'] = \' \'.join(cleaned_footnote.split())\\n    else:\\n        details[\'past_due_footnote\'] = None\\n    \\n    # Special instructions - multi-line text that may span several lines with line prefixes\\n    instructions_match = re.search(r\'(Please return this portion.*?ac