n            \\"document_date\\": extract_document_date(lines) or \\"\\",  # Use first statement date\\n            \\"form_type\\": \\"Loan Billing Statement\\",\\n            \\"processing_date\\": None,  # Not available in source document\\n            \\"processing_time\\": None,  # Not available in source document\\n            \\"extra\\": {\\n                # Jack Henry format indicators\\n                \\"format_type\\": \\"JH_ABSOLUTE_RELATIVE\\",  # Jack Henry absolute/relative line numbering\\n                \\"line_prefix_format\\": True  # Indicates use of line number prefixes\\n            }\\n        },\\n        \\"bank\\": {\\n            # Bank details are not typically present in LN6280P documents\\n            \\"name\\": \\"\\",\\n            \\"address\\": {\\"street\\": None, \\"city\\": None, \\"state\\": None, \\"zip\\": None},  # Explicit null values\\n            \\"phone\\": phone_number,  # Extract phone number for RegionalBank\\n            \\"routing_number\\": None,\\n            \\"extra\\": {}\\n        },\\n        \\"notices\\": [],  # Will be populated with parsed loan statements\\n        \\"extra\\": {}\\n    }\\n\\n    # Find all section boundaries in the document\\n    boundaries = find_section_boundaries(lines)\\n    \\n    # Process each section as a separate loan statement\\n    for i in range(len(boundaries)):\\n        # Calculate section boundaries\\n        start_index = boundaries[i]\\n        end_index = boundaries[i + 1] if i + 1 < len(boundaries) else len(lines)\\n        \\n        # Extract section text for this loan statement\\n        section_text = \'\\\\n\'.join(lines[start_index:end_index])\\n        \\n        # Parse the section if it contains meaningful content\\n        if section_text.strip():\\n            notice = parse_notice_section(section_text)\\n            if notice:\\n                document[\\"notices\\"].append(notice)\\n                \\n    return document\\n\\ndef main():\\n    \\"\\"\\"\\n    Main entry point for the LN6280P parser script.\\n    \\n    Command Line Usage:\\n        python parser.py <input_file>\\n        \\n    Arguments:\\n        input_file: Path to the LN6280P document text file\\n        \\n    Output:\\n        Structured JSON printed to stdout\\n        Error messages printed to stderr\\n        \\n    Exit Codes:\\n        0: Success\\n        1: Error (file not found, parsing error, etc.)\\n        \\n    Error Handling:\\n    - Validates command line arguments\\n    - Checks file existence\\n    - Handles encoding issues (UTF-8 required for Unicode names)\\n    - Provides meaningful error messages\\n    \\"\\"\\"\\n    # Validate command line arguments\\n    if len(sys.argv) != 2:\\n        print(\\"Usage: python parser_ln6280p.py <input_file>\\", file=sys.stderr)\\n        sys.exit(1)\\n    \\n    input_file = sys.argv[1]\\n    \\n    try:\\n        # Read input file with UTF-8 encoding to handle international characters\\n        with open(input_file, \'r\', encoding=\'utf-8\') as f:\\n            raw_text = f.read()\\n        \\n        # Parse the document\\n        document = parse_ln6280p(raw_text)\\n        \\n        # Output JSON with proper Unicode handling\\n        # ensure_ascii=False preserves Unicode characters in output\\n        # indent=2 provides readable formatting\\n        print(json.dumps(document, indent=2, ensure_ascii=False))\\n        \\n    except FileNotFoundError:\\n        print(f\\"Error: File \'{input_file}\' not found.\\", file=sys.stderr)\\n        sys.exit(1)\\n    except Exception as e:\\n        print(f\\"An unexpected error occurred: {e}\\", file=sys.stderr)\\n        sys.exit(1)\\n\\n# Script entry point - only run main() when script is executed directly\\nif __name__ == \\"__main__\\":\\n    main()"}', 'return_value': "=== COMPREHENSIVE TEST RESULTS FOR RegionalBank ===\nDifficulty: easy\nOverall Pass Rate: 0.0%\n\nmain_example: ❌ FAIL\n  Execution time: 0.01s\n  Error: root.no