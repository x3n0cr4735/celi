  Date string in M/D/YY format or None if not found\\n        \\n    Pattern Matching:\\n    - Looks for \\"Statement Date\\" or \\"Billing Date\\" followed by whitespace and a date\\n    - Date format: 1-2 digits / 1-2 digits / 2 digits (M/D/YY)\\n    - Case-insensitive matching\\n    \\"\\"\\"\\n    for line in lines:\\n        # Search for either \\"Statement Date\\" (JH) or \\"Billing Date\\" (RegionalBank)\\n        match = re.search(r\'(?:Statement Date|Billing Date)\\\\s+(\\\\d{1,2}/\\\\d{1,2}/\\\\d{2})\', line, re.IGNORECASE)\\n        if match:\\n            return match.group(1).strip()\\n    return None\\n\\ndef find_customer_info(lines: List[str]) -> Tuple[Optional[str], List[str]]:\\n    \\"\\"\\"\\n    Finds customer name and address block using robust patterns.\\n    It supports names with titles, suffixes, and Unicode characters.\\n    \\n    Args:\\n        lines: List of lines from a single notice section\\n        \\n    Returns:\\n        Tuple of (customer_name, address_lines)\\n        \\n    Customer Name Extraction:\\n    - Looks for lines starting with \'3\' (Jack Henry) or \'4\' (RegionalBank) customer name prefix\\n    - Supports complex names with:\\n      * Titles: DR., PROF., REV., MR., MS., etc.\\n      * Suffixes: JR., SR., III, IV, etc.\\n      * International characters: \\u00c0-\\u00ff (Unicode range)\\n      * Special characters: apostrophes, hyphens, ampersands, periods\\n      * Business entities: LLC, CORP., INC., TRUST, etc.\\n    \\n    Address Extraction:\\n    - Address lines follow customer name\\n    - Lines prefixed with \'1 \' are address components\\n    - Stops when hitting \\"Account Activity Summary\\" section\\n    - Supports multi-line addresses (street, city/state/zip)\\n    \\"\\"\\"\\n    for i, line in enumerate(lines):\\n        stripped = line.strip()\\n        # Pattern: line starts with \'3\' (JH) or \'4\' (RegionalBank), followed by what looks like a name.\\n        if stripped.startswith(\'3\') or stripped.startswith(\'4\'):\\n            # This regex captures complex names, including titles, suffixes, hyphens, and Unicode.\\n            # [A-Z\\u00c0-\\u00ff] covers English + extended Latin characters for international names\\n            # .,\\\\\'&\\\\s- covers punctuation commonly found in names and business entities\\n            name_match = re.match(r\'[34]\\\\s+([A-Z\\u00c0-\\u00ff.,\\\\\'&\\\\s-]+)\', stripped, re.UNICODE | re.IGNORECASE)\\n            if name_match:\\n                # Clean up the customer name by normalizing whitespace\\n                customer_name = \' \'.join(name_match.group(1).strip().split())\\n                address_lines = []\\n                \\n                # Address lines typically follow on subsequent lines.\\n                # Look ahead up to 4 lines for address components\\n                for j in range(i + 1, min(i + 5, len(lines))):\\n                    addr_line = lines[j].strip()\\n                    \\n                    # Remove \'1 \' prefix if present (Jack Henry address line marker)\\n                    if addr_line.startswith(\'1 \'):\\n                        addr_line = addr_line[2:].strip()\\n                    \\n                    # Stop if we hit the next major section header\\n                    if \\"Account Activity Summary\\" in addr_line:\\n                        break\\n                    \\n                    # Add non-empty address lines\\n                    if addr_line:\\n                        address_lines.append(addr_line)\\n                \\n                # A valid customer block needs both name and at least one address line\\n                if customer_name and address_lines:\\n                    return customer_name, address_lines\\n    return None, []\\n\\ndef extract_summary_field(text: str, patterns: List[str]) -> Optional[str]:\\n    \\"\\"\\"\\n    Extracts a value from summary tables using regex patterns.\\n    It removes leading/trailing whitespace and currency