                boundaries.append(i)\\n                    break\\n    return boundaries\\n\\ndef extract_document_date(lines: List[str]) -> Optional[str]:\\n    \\"\\"\\"\\n    Extracts the main document date from the first notice.\\n    Enhanced to support both \\"Statement Date\\" (JH) and \\"Billing Date\\" (RegionalBank).\\n    \\"\\"\\"\\n    for line in lines:\\n        # Try JH format first\\n        match = re.search(r\'Statement Date\\\\s+(\\\\d{1,2}/\\\\d{1,2}/\\\\d{2})\', line, re.IGNORECASE)\\n        if match:\\n            return match.group(1).strip()\\n        \\n        # Try RegionalBank format\\n        match = re.search(r\'Billing Date\\\\s+(\\\\d{1,2}/\\\\d{1,2}/\\\\d{2})\', line, re.IGNORECASE)\\n        if match:\\n            return match.group(1).strip()\\n    return None\\n\\ndef extract_phone_number(lines: List[str]) -> Optional[str]:\\n    \\"\\"\\"\\n    Extracts phone number from RegionalBank format documents.\\n    Returns None for JH format (which doesn\'t have phone numbers).\\n    \\"\\"\\"\\n    for line in lines:\\n        match = re.search(r\'Phone Number\\\\s+(\\\\([0-9]{3}\\\\)\\\\s[0-9]{3}-[0-9]{4})\', line, re.IGNORECASE)\\n        if match:\\n            return match.group(1).strip()\\n    return None\\n\\ndef find_customer_info(lines: List[str]) -> Tuple[Optional[str], List[str]]:\\n    \\"\\"\\"\\n    Enhanced customer info extraction supporting both prefix \\"3\\" (JH) and \\"4\\" (RegionalBank).\\n    \\"\\"\\"\\n    for i, line in enumerate(lines):\\n        stripped = line.strip()\\n        # Try both prefix patterns - JH uses \\"3\\", RegionalBank uses \\"4\\"\\n        for prefix in [\'3\', \'4\']:\\n            if stripped.startswith(prefix):\\n                name_match = re.match(f\'{prefix}\\\\\\\\s+([A-Z\\u00c0-\\u00ff.,\\\\\'&\\\\\\\\s-]+)\', stripped, re.UNICODE | re.IGNORECASE)\\n                if name_match:\\n                    customer_name = \' \'.join(name_match.group(1).strip().split())\\n           