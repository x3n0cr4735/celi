             address_lines = []\\n                    \\n                    # Address lines follow on subsequent lines\\n                    for j in range(i + 1, min(i + 5, len(lines))):\\n                        addr_line = lines[j].strip()\\n                        \\n                        if addr_line.startswith(\'1 \'):\\n                            addr_line = addr_line[2:].strip()\\n                        \\n                        if \\"Account Activity Summary\\" in addr_line:\\n                            break\\n                        \\n                        if addr_line:\\n                            address_lines.append(addr_line)\\n                    \\n                    if customer_name and address_lines:\\n                        return customer_name, address_lines\\n    return None, []\\n\\ndef extract_summary_field(text: str, patterns: List[str]) -> Optional[str]:\\n    \\"\\"\\"\\n    Enhanced field extraction with multiple pattern support for format variations.\\n    \\"\\"\\"\\n    for pattern in patterns:\\n        match = re.search(pattern, text, re.DOTALL | re.IGNORECASE)\\n        if match:\\n            for group in match.groups():\\n                if group:\\n                    return group.strip().replace(\'$\', \'\')\\n    return None\\n\\ndef parse_transaction_history(lines: List[str]) -> List[Dict[str, Optional[str]]]:\\n    \\"\\"\\"\\n    Transaction history parsing - same for both formats.\\n    \\"\\"\\"\\n    history = []\\n    in_history_section = False\\n    header_found = False\\n    \\n    for line in lines:\\n        if \\"Loan Transaction History\\" in line:\\n            in_history_section = True\\n            continue\\n        \\n        if in_history_section and \\"Date\\" in line and \\"Description\\" in line:\\n            header_found = True\\n            continue\\n\\n        if not header_found or \\"---\\" in line:\\n            continue\\n        \\n        match = re.match(r\'^\\\\s*(?:\\\\d\\\\s*)?(\\\\d{1,2}/\\\\d{1,2}/\\\\d{2})\\\\s+([\\\\w\\\\s-]+?)\\\\s+\\\\$?\\\\s*([\\\\d,.]*)\\\\s+\\\\$?\\\\s*([\\\\d,.]+)\\\\s*$\', line)\\n        if match:\\n            amount_str = match.group(3).strip() or None\\n            \\n            history.append({\\n                \\"date\\": match.group(1).strip(),\\n                \\"description\\": match.group(2).strip(),\\n                \\"amount\\": amount_str,\\n                \\"balance\\": match.group(4).strip()\\n            })\\n    return history\\n\\ndef extract_footnote(lines: List[str]) -> Optional[str]:\\n    \\"\\"\\"\\n    Enhanced footnote extraction that handles multi-line footnotes with line prefixes.\\n    \\"\\"\\"\\n    footnote_parts = []\\n    found_start = False\\n    \\n    for line in lines:\\n        stripped = line.strip()\\n        \\n        # Look for the start of the footnote\\n        if \\"*Past due amount includes total late\\" in stripped:\\n            found_start = True\\n            # Extract the part after the line prefix\\n            if stripped.startswith(\'1 \'):\\n                text_part = stripped[2:].strip()\\n            else:\\n                text_part = stripped\\n            footnote_parts.append(text_part)\\n            continue\\n        \\n        # If we found the start, look for continuation\\n        if found_start:\\n            if stripped.startswith(\'1 \') and \\"fees owed.\\" in stripped:\\n                text_part = stripped[2:].strip()\\n                footnote_parts.append(text_part)\\n                break\\n            elif \\"fees owed.\\" in stripped:\\n                footnote_parts.append(stripped)\\n                break\\n    \\n    if footnote_parts:\\n        return \' \'.join(footnote_parts)\\n    return None\\n\\ndef parse_notice_section(section_text: str) -> Optional[Dict]:\\n    \\"\\"\\"\\n    Enhanced notice parsing supporting both JH and RegionalBank formats.\\n    Uses multiple patterns for each field to handle format variations.\\n    \\"\\"\\"\\n    lines = section_text.split(\'\\\\n\')\\n    details = {}\\n\\n    # Enhanced date field extraction - try both formats\\n    details[\'statement_date\'] = extract_summary_field(section_text, [\\n        r\'Statement Date\\\\s+([\\\\d/]+)\',  # JH format\\n        r\'Billing Date\\\\s+([\\\\d/]+)\'     # RegionalBank format\\n    ])\\n    \\n    details[\'payment_due_date\'] = extract_summary_field(section_text, [\\n        r\'Payment Due Date\\\\s+([\\\\d/]+)\',  # JH format\\n        r\'Due Date\\\\s+([\\\\d/]+)\'           # RegionalBank format\\n    ])\\n    \\n    # Enhanced amount field extraction - try both formats\\n    details[\'total_amount_due\'] = extract_summary_field(section_text, [\\n        r\'Total Amount Due\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\',    # JH format\\n        r\'Payment Amount Due\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'   # RegionalBank format\\n    ])\\n    \\n    # Enhanced balance field extraction - try both formats\\n    details[\'current_balance\'] = extract_summary_field(section_text, [\\n        r\'Current Balance\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\',     # JH format\\n        r\'Outstanding Balance\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'  # RegionalBank format\\n    ])\\n    \\n    # Standard fields that are the same in both formats\\n    details[\'payments_and_credits\'] = extract_summary_field(section_text, [r\'Payments and Credits\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'])\\n    details[\'advances_and_debits\'] = extract_summary_field(section_text, [r\'Advances and Debits\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'])\\n    details[\'interest_paid_this_year\'] = extract_summary_field(section_text, [r\'Interest Paid this Year\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'])\\n    details[\'past_due_amount\'] = extract_summary_field(section_text, [r\'Past Due Amount\\\\s*\\\\*\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'])\\n    details[\'credit_limit\'] = extract_summary_field(section_text, [r\'Credit Limit\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'])\\n    details[\'available_credit\'] = extract_summary_field(section_text, [r\'Available Credit\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'])\\n    \\n    # Enhanced payment amount field extraction - try both formats\\n    details[\'regular_payment_amount\'] = extract_summary_field(section_text, [\\n        r\'Regular Payment Amount\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\',  # JH format\\n        r\'Monthly Payment\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'          # RegionalBank format\\n    ])\\n    \\n    # Standard fields that are the same in both formats\\n    details[\'principal_due\'] = extract_summary_field(section_text, [r\'Principal\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'])\\n    details[\'interest_due\'] = extract_summary_field(section_text, [r\'Interest\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'])\\n    details[\'total_late_fees\'] = extract_summary_field(section_text, [r\'Total Late Fees\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'])\\n\\n    # Enhanced footnote extraction using dedicated function\\n    details[\'past_due_footnote\'] = extract_footnote(lines)\\n    \\n    instructions_match = re.search(r\'(Please return this portion.*?account\\\\.)\', section_text, re.DOTALL)\\n    if instructions_match:\\n        text = instructions_match.group(1)\\n        cleaned_text = re.sub(r\'\\\\s*\\\\n\\\\s*1\\\\s*\', \' \', text).strip()\\n        details[\'special_instructions\'] = \' \'.join(cleaned_text.split())\\n    else:\\n        details[\'special_instructions\'] = None\\n\\n    # Parse transaction history\\n    details[\'transactions\'] = parse_transaction_history(lines)\\n    \\n    # Enhanced customer info extraction\\n    customer_name, address_lines = find_customer_info(lines)\\n    if not customer_name:\\n        return None\\n\\n    # Build notice structure\\n    notice = {\\n        \\"notice_type\\": \\"Loan Billing Statement\\",\\n        \\"customer\\": {\\n            \\"name\\": customer_name, \\n            \\"address\\": {\\"street\\": None, \\"city\\": None, \\"state\\": None, \\"zip\\": None}, \\n            \\"extra\\": {}\\n        },\\n        \\"account_number\\": extract_summary_field(section_text, [r\'Account Number\\\\s+(\\\\w+)\']),\\n        \\"details\\": details,\\n        \\"extra\\": {}\\n    }\\n\\n    # Address parsing - same for both formats\\n    if address_lines:\\n        addr_match = re.search(r\'^(.*?)\\\\s+([A-Z]{2})\\\\s+(\\\\d{5}(?:-\\\\d{4})?)$\', address_lines[-1])\\n        if addr_match:\\n            city_state_zip_line = address_lines.pop()\\n            notice[\\"customer\\"][\\"address\\"][\\"street\\"] = \\" \\".join(address_lines)\\n            notice[\\"customer\\"][\\"address\\"][\\"city\\"] = addr_match.group(1).strip().rstrip(\',\')\\n            notice[\\"customer\\"][\\"address\\"][\\"state\\"] = addr_match.group(2).strip()\\n            notice[\\"customer\\"][\\"address\\"][\\"zip\\"] = addr_match.group(3).strip()\\n        else: \\n            notice[\\"customer\\"][\\"address\\"][\\"street\\"] = address_lines[0]\\n             \\n    return notice\\n\\ndef parse_ln6280p(raw_text: str) -> Dict:\\n    \\"\\"\\"\\n    Enhanced main parsing function supporting multiple bank formats.\\n    \\"\\"\\"\\n    lines = raw_text.split(\'\\\\n\')\\n    \\n    # Extract phone number for RegionalBank format (will be None for JH)\\n    phone_number = extract_phone_number(lines)\\n    \\n    document = {\\n        \\"metadata\\": {\\n            \\"bank_name\\": \\"\\",\\n            \\"document_type\\": \\"LN6280P\\",\\n            \\"document_date\\": extract_document_date(lines) or \\"\\",\\n            \\"form_type\\": \\"Loan Billing Statement\\",\\n            \\"processing_date\\": None,\\n            \\"processing_time\\": None,\\n            \\"extra\\": {\\n                \\"format_type\\": \\"JH_ABSOLUTE_RELATIVE\\",\\n                \\"line_prefix_format\\": True\\n            }\\n        },\\n        \\"bank\\": {\\n            \\"name\\": \\"\\",\\n            \\"address\\": {  # Fixed: provide proper address structure\\n                \\"street\\": None,\\n                \\"city\\": None,\\n                \\"state\\": None,\\n                \\"zip\\": None\\n            },\\n            \\"phone\\": phone_number,  # Enhanced: populate phone for RegionalBank\\n            \\"routing_number\\": None,\\n            \\"extra\\": {}\\n        },\\n        \\"notices\\": [],\\n        \\"extra\\": {}\\n    }\\n\\n    boundaries = find_section_boundaries(lines)\\n    \\n    for i in range(len(boundaries)):\\n        start_index = boundaries[i]\\n        end_index = boundaries[i + 1] if i + 1 < len(boundaries) else len(lines)\\n        \\n        section_text = \'\\\\n\'.join(lines[start_index:end_index])\\n        \\n        if section_text.strip():\\n            notice = parse_notice_section(section_text)\\n            if notice:\\n                document[\\"notices\\"].append(notice)\\n                \\n    return document\\n\\ndef main():\\n    \\"\\"\\"\\n    Main entry point for the enhanced LN6280P parser.\\n    \\"\\"\\"\\n    if len(sys.argv) != 2:\\n        print(\\"Usage: python parser_ln6280p.py <input_file>\\", file=sys.stderr)\\n        sys.exit(1)\\n    \\n    input_file = sys.argv[1]\\n    \\n    try:\\n        with open(input_file, \'r\', encoding=\'utf-8\') as f:\\n            raw_text = f.read()\\n        \\n        document = parse_ln6280p(raw_text)\\n        \\n        print(json.dumps(document, indent=2, ensure_ascii=False))\\n        \\n    except FileNotFoundError:\\n        print(f\\"Error: File \'{input_file}\' not found.\\", file=sys.stderr)\\n        sys.exit(1)\\n    except Exception as e:\\n        print(f\\"An unexpected error occurred: {e}\\", file=sys.stderr)\\n        sys.exit(1)\\n\\nif __name__ == \\"__main__\\":\\n    main()", "detailed_errors": true}', 'return_value': "=== COMPREHENSIVE TEST RESULTS FOR RegionalBank ===\nDifficulty: easy\nOverall Pass Rate: 60.0%\n\nmain_example: ✅ PASS\n  Execution time: 0.01s\n\ntest_case_1: ✅ PASS\n  Execution time: 0.01s\n\ntest_case_2: ✅ PASS\n  Execution time: 0.01s\n\nstress_test_1: ❌ FAIL\n  Execution time: 0.01s\n  Error: root.notices[1].customer.address.street: 'C/O EXECUTIVE PROPERTY MANAGEMENT 9876 WALL STREET SUITE 2000' != 'C/O EXECUTIVE PROPERTY MANAGEMENT, 9876 WALL STREET SUITE 2000'\n\nstress_test_2: ❌ FAIL\n  Execution time: 0.01s\n  Error: root.notices[0].details.transactions: List length mismatch - 3 vs 4\n\n⚠️  2 tests failed\n\n=== DETAILED ERROR INFORMATION ===\n\nTest: stress_test_1\nError: root.notices[1].customer.address.street: 'C/O EXECUTIVE PROPERTY MANAGEMENT 9876 WALL STREET SUITE 2000' != 'C/O EXECUTIVE PROPERTY MANAGEMENT, 9876 WALL STREET SUITE 2000'\nActual: 'C/O EXECUTIVE PROPERTY MANAGEMENT 9876 WALL STREET SUITE 2000'\nExpected: 'C/O EXECUTIVE PROPERTY MANAGEMENT, 9876 WALL STREET SUITE 2000'\n\nTest: stress_test_2\nError: root.notices[0].details.transactions: List length mismatch - 3 vs 4", 'is_error': False}[0m
