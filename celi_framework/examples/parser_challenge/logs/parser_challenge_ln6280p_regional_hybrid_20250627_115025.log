on\n#!/usr/bin/env python3\n"""\nLN6280P Parser - Loan Billing Statement\n\nThis parser is designed to handle LN6280P documents, which are standard loan billing\nstatements, often from platforms like Jack Henry. These documents typically include\na header with account details, an account activity summary, an explanation of\nthe amount due, a detailed transaction history, and a payment slip.\n\nDocument Type: LN6280P - Loan Billing Statement\nFormat: Multi-notice batch document with standardized section headers.\n\nROBUST PARSING APPROACH:\n- Uses header keyword detection for section boundaries.\n- Flexible, multi-pattern extraction for key-value pairs in summary tables.\n- Specific logic to parse the fixed-column transaction history table.\n- Tolerant customer address block detection with support for Unicode.\n- Handles alphanumeric account numbers and varied name formats.\n\nDOCUMENT STRUCTURE:\nThe LN6280P document typically contains:\n1. Document header with LN6280P identifier\n2. Multiple loan billing statements in batch format\n3. Each statement contains:\n   - Account header with \'001\' marker and "Loan Billing Statement" title\n   - Statement date and account number\n   - Customer name (prefixed with \'3\' or \'4\') and address lines (prefixed with \'1\')\n   - Account Activity Summary table with financial details\n   - Explanation of Amount Due section\n   - Loan Transaction History table\n   - Payment stub section (prefixed with \'046\')\n\nPARSING STRATEGY:\n- Section boundary detection using \'001\' markers\n- Customer name extraction using \'3\' or \'4\' prefix patterns\n- Address parsing with city/state/zip separation\n- Financial data extraction from two-column summary tables\n- Transaction history parsing from fixed-width table format\n- Unicode character support for international names\n- Alphanumeric account number handling\n"""\n\nimport sys\nimport json\nimport re\nfrom typing import List, Dict, Optional, Tuple\n\ndef find_section_boundaries(lines: List[str]) -> List[int]:\n    """\n    Finds the starting line index of each new notice section. For LN6280P,\n    the most reliable marker is the page start marker \'001\' often followed\n    by the "Loan Billing Statement" title.\n    \n    Args:\n        lines: List of all document lines\n        \n    Returns:\n        List of line indices where new sections begin\n        \n    Algorithm:\n    1. Scan through all lines looking for \'001\' prefix markers\n    2. For each \'001\' found, check the next 2-3 lines for "Loan Billing Statement"\n    3. If title is found, mark this as a section boundary\n    4. Avoid duplicate boundaries in case of false positives\n    """\n    boundaries = []\n    \n    # Iterate through each line with its index\n    for i, line in enumerate(lines):\n        # Check if line starts with \'001\' (Jack Henry page marker)\n        if line.strip().startswith(\'001\'):\n            # Confirm it\'s a new notice by checking for the title in the vicinity\n            # Look ahead up to 3 lines to find the statement title\n            for j in range(i, min(i + 3, len(lines))):\n                if "Loan Billing Statement" in lines[j]:\n                    # Avoid adding duplicate boundaries\n                    if i not in boundaries:\n                        boundaries.append(i)\n                    break\n    return boundaries\n\ndef extract_document_date(lines: List[str]) -> Optional[str]:\n    """\n    Extracts the main document date from the first notice\'s date field.\n    This becomes the overall document date in the metadata section.\n    \n    Args:\n        lines: List of all document lines\n        \n    Returns:\n        Date string in M/D/YY format or None if not found\n        \n    Pattern Matching:\n    - Looks for "Statement Date" or "Billing Date" followed by whitespace and a date\n    - Date format: 1-2 digits / 1-2 digits / 2 digits (M/D/YY)\n    - Case-insensitive matching\n    """\n    for line in lines:\n        # Search for either "Statement Date" or "Billing Date" followed by a date pattern\n        match = re.search(r\'(?:Statement Date|Billing Date)\\s+(\\d{1,2}/\\d{1,2}/\\d{2})\', line, re.IGNORECASE)\n        if match:\n            return match.group(1).strip()\n    return None\n\ndef extract_phone_number(lines: List[str]) -> Optional[str]:\n    """\n    Extracts phone number from the document if present.\n    \n    Args:\n        lines: List of all document lines\n        \n    Returns:\n        Phone number string or None if not found\n    """\n    for line in lines:\n        # Search for "Phone Number" followed by a phone number pattern\n        match = re.search(r\'Phone Number\\s+(\\([0-9]{3}\\)\\s*[0-9]{3}-[0-9]{4})\', line, re.IGNORECASE)\n        if match:\n            return match.group(1).strip()\n    return None\n\ndef find_customer_info(lines: List[str]) -> Tuple[Optional[str], List[str]]:\n    """\n    Finds customer name and address block using robust patterns.\n    It supports names with titles, suffixes, and Unicode characters.\n    \n    Args:\n        lines: List of lines from a single notice section\n        \n    Returns:\n        Tuple of (customer_name, address_lines)\n        \n    Customer Name Extraction:\n    - Looks for lines starting with \'3\' or \'4\' (customer name prefix)\n    - Supports complex names with:\n      * Titles: DR., PROF., REV., MR., MS., etc.\n      * Suffixes: JR., SR., III, IV, etc.\n      * International characters: À-ÿ (Unicode range)\n      * Special characters: apostrophes, hyphens, ampersands, periods\n      * Business entities: LLC, CORP., INC., TRUST, etc.\n    \n    Address Extraction:\n    - Address lines follow customer name\n    - Lines prefixed with \'1 \' are address components\n    - Stops when hitting "Account Activity Summary" section\n    - Supports multi-line addresses (street, city/state/zip)\n    """\n    for i, line in enumerate(lines):\n        stripped = line.strip()\n        # Pattern: line starts with \