    )

    parser.add_argument(
        "--openai-api-key",
        type=str,
        default=None,
        help="Your OpenAI API key.  For security reasons, it is preferable to set this as an environment variable "
        "OPENAI_API_KEY rather than passing it on the command line.  If you are serving your own models using "
