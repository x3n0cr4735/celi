                elif test_info.get('error_type') == 'output_mismatch':
                    prompt += f"Output Mismatch: {test_info['error_message']}\n"
                    
                    if 'actual_output' in test_info and 'expected_output' in test_info:
                        try:
                            # Parse JSON for pretty comparison
