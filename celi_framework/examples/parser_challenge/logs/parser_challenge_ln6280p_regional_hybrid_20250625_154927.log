mber handling\\n\\"\\"\\"\\n\\nimport sys\\nimport json\\nimport re\\nfrom typing import List, Dict, Optional, Tuple\\n\\ndef find_section_boundaries(lines: List[str]) -> List[int]:\\n    \\"\\"\\"\\n    Finds the starting line index of each new notice section. For LN6280P,\\n    the most reliable marker is the page start marker \'001\' often followed\\n    by the \\"Loan Billing Statement\\" title.\\n    \\n    Args:\\n        lines: List of all document lines\\n        \\n    Returns:\\n        List of line indices where new sections begin\\n        \\n    Algorithm:\\n    1. Scan through all lines looking for \'001\' prefix markers\\n    2. For each \'001\' found, check the next 2-3 lines for \\"Loan Billing Statement\\"\\n    3. If title is found, mark this as a section boundary\\n    4. Avoid duplicate boundaries in case of false positives\\n    \\"\\"\\"\\n    boundaries = []\\n    \\n    # Iterate through each line with its index\\n    for i, line in enumerate(lines):\\n        # Check if line starts with \'001\' (Jack Henry page marker)\\n        if line.strip().startswith(\'001\'):\\n            # Confirm it\'s a new notice by checking for the title in the vicinity\\n            # Look ahead up to 3 lines to find the statement title\\n            for j in range(i, min(i + 3, len(lines))):\\n                if \\"Loan Billing Statement\\" in lines[j]:\\n                    # Avoid adding duplicate boundaries\\n                    if i not in boundaries:\\n                        boundaries.append(i)\\n                    break\\n    return boundaries\\n\\ndef extract_document_date(lines: List[str]) -> Optional[str]:\\n    \\"\\"\\"\\n    Extracts the main document date from the first notice\'s date field.\\n    This becomes the overall document date in the metadata section.\\n    \\n    Args:\\n        lines: List of all document lines\\n        \\n    Returns:\\n        Date string in M/D/YY format or None if not found\\n        \\n    Pattern Matching:\\n    - Looks for \\"Statement Date\\" or \\"Billing Date\\" followed by whitespace and a date\\n    - Date format: 1-2 digits / 1-2 digits / 2 digits (M/D/YY)\\n    - Case-insensitive matching\\n    \\"\\"\\"\\n    for line in lines:\\n        # Search for either \\"Statement Date\\" or \\"Billing Date\\" followed by a date pattern\\n        match = re.search(r\'(?:Statement Date|Billing Date)\\\\s+(\\\\d{1,2}/\\\\d{1,2}/\\\\d{2})\', line, re.IGNORECASE)\\n        if match:\\n            return match.group(1).strip()\\n    return None\\n\\ndef extract_phone_number(lines: List[str]) -> Optional[str]:\\n    \\"\\"\\"\\n    Extracts phone number from the document if present.\\n    \\n    Args:\\n        lines: List of all document lines\\n        \\n    Returns:\\n        Phone number string or None if not found\\n    \\"\\"\\"\\n    for line in lines:\\n        # Search for \\"Phone Number\\" followed by a phone number pattern\\n        match = re.search(r\'Phone Number\\\\s+(\\\\([0-9]{3}\\\\)\\\\s*[0-9]{3}-[0-9]{4})\', line, re.IGNORECASE)\\n        if match:\\n            return match.group(1).strip()\\n    return None\\n\\ndef find_customer_info(lines: List[str]) -> Tuple[Optional[str], List[str]]:\\n    \\"\\"\\"\\n    Finds customer name and address block using robust patterns.\\n    It supports names with titles, suffixes, and Unicode characters.\\n    \\n    Args:\\n        lines: List of lines from a single notice section\\n        \\n    Returns:\\n        Tuple of (customer_name, address_lines)\\n        \\n    Customer Name Extraction:\\n    - Looks for lines starting with \'3\' or \'4\' (customer name prefix)\\n    - Supports complex names with:\\n      * Titles: DR., PROF., REV., MR., MS., etc.\\n      * Suffixes: JR., SR., III, IV, etc.\\n      * International characters: \\u00c0-\\u00ff (Unicode range)\\n      * Special characters: apostrophes, hyphens, ampersands, periods\\n      * Business entities: LLC, CORP., INC., TRUST, etc.\\n    \\n    Address Extraction:\\n    - Address lines follow customer name\\n    - Lines prefixed with \'1 \' are address components\\n    - Stops when hitting \\"Account Activity Summary\\" section\\n    - Supports multi-line addresses (street, city/state/zip)\\n    \\"\\"\\"\\n    for i, line in enumerate(lines):\\n        stripped = line.strip()\\n        # Pattern: line starts with \'3\' or \'4\', followed by what looks like a name.\\n        if stripped.startswith(\'3\') or stripped.startswith(\'4\'):\\n            # This regex captures complex names, including titles, suffixes, hyphens, and Unicode.\\n            # [A-Z\\u00c0-\\u00ff] covers English + extended Latin characters for international names\\n            # .,\\\\\'&\\\\s- covers punctuation commonly found in names and business entities\\n            name_match = re.match(r\'[34]\\\\s+([A-Z\\u00c0-\\u00ff.,\\\\\'&\\\\s-]+)\', stripped, re.UNICODE | re.IGNORECASE)\\n            if name_match:\\n                # Clean up the customer name by normalizing whitespace\\n                customer_name = \' \'.join(name_match.group(1).strip().split())\\n                address_lines = []\\n                \\n                # Address lines typically follow on subsequent lines.\\n                # Look ahead up to 4 lines for address components\\n                for j in range(i + 1, min(i + 5, len(lines))):\\n                    addr_line = lines[j].strip()\\n                    \\n                    # Remove \'1 \' prefix if present (Jack Henry address line marker)\\n                    if addr_line.startswith(\'1 \'):\\n                        addr_line = addr_line[2:].strip()\\n                    \\n                    # Stop if we hit the next major section header\\n                    if \\"Account Activity Summary\\" in addr_line:\\n                        break\\n                    \\n                    # Add non-empty address lines\\n                    if addr_line:\\n                        address_lines.append(addr_line)\\n                \\n                # A valid customer block needs both name and at least one address line\\n                if customer_name and address_lines:\\n                    return customer_name, address_lines\\n    return None, []\\n\\ndef extract_summary_field(text: str, patterns: List[str]) -> Optional[str]:\\n    \\"\\"\\"\\n    Extracts a value from summary tables using regex patterns.\\n    It removes leading/trailing whitespace and currency symbols.\\n    \\n    Args:\\n        text: The full section text to search within\\n        patterns: List of regex patterns to try in order\\n        \\n    Returns:\\n        Extracted field value with $ symbols removed, or None\\n        \\n    Field Extraction Strategy:\\n    - Tries multiple regex patterns in sequence (fallback approach)\\n    - Handles variations in spacing and formatting\\n    - Removes currency symbols ($) but preserves commas in numbers\\n    - Returns first successful match from any pattern\\n    - Uses DOTALL and IGNORECASE flags for robust matching\\n    \\"\\"\\"\\n    for pattern in patterns:\\n        # Use DOTALL to match across line breaks, IGNORECASE for flexibility\\n        match = re.search(pattern, text, re.DOTALL | re.IGNORECASE)\\n        if match:\\n            # Return the first non-empty capture group.\\n            # This allows patterns with multiple optional groups\\n            for group in match.groups():\\n                if group:\\n                    # Strip whitespace and remove $ symbols, but keep commas\\n                    return group.strip().replace(\'$\', \'\')\\n    return None\\n\\ndef parse_transaction_history(lines: List[str]) -> List[Dict[str, Optional[str]]]:\\n    \\"\\"\\"\\n    Parses the \\"Loan Transaction History\\" table, handling various alignments\\n    and optional amount values.\\n    \\n    Args:\\n        lines: List of lines from a single notice section\\n        \\n    Returns:\\n        List of transaction dictionaries with