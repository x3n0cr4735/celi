ctured data: customer info, address, transactions\\n    \\"\\"\\"\\n    lines = section_text.split(\'\\\\n\')\\n    details = {}\\n\\n    # Extract all key-value fields from the summary tables.\\n    # These fields come from the \\"Account Activity Summary\\" and \\"Explanation of Amount Due\\" sections\\n    # Each field uses regex patterns to handle spacing and formatting variations\\n    \\n    # Date fields - statement and payment due dates (support both JH and RegionalBank formats)\\n    details[\'statement_date\'] = extract_summary_field(section_text, [\\n        r\'Statement Date\\\\s+([\\\\d/]+)\',\\n        r\'Billing Date\\\\s+([\\\\d/]+)\'\\n    ])\\n    details[\'payment_due_date\'] = extract_summary_field(section_text, [\\n        r\'Payment Due Date\\\\s+([\\\\d/]+)\',\\n        r\'Due Date\\\\s+([\\\\d/]+)\'\\n    ])\\n    \\n    # Primary amount field - what customer owes (support both formats)\\n    details[\'total_amount_due\'] = extract_summary_field(section_text, [\\n        r\'Total Amount Due\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\',\\n        r\'Payment Amount Due\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'\\n    ])\\n    \\n    # Account summary fields from left column of summary table (support both formats)\\n    details[\'current_balance\'] = extract_summary_field(section_text, [\\n        r\'Current Balance\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\',\\n        r\'Outstanding Balance\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'\\n    ])\\n    details[\'payments_and_credits\'] = extract_summary_field(section_text, [r\'Payments and Credits\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'])\\n    details[\'advances_and_debits\'] = extract_summary_field(section_text, [r\'Advances and Debits\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'])\\n    details[\'interest_paid_this_year\'] = extract_summary_field(section_text, [r\'Interest Paid this Year\\\\s*\\\\$?\\\\s*([,\\\\d]+\\\\.\\\\d{2})\'])\\n    details[\'past_due_amount\'] = extract_summary_field(